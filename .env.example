# Copy to .env. Both are read by the /rsc demo pages; any text works.

# No NEXT_PUBLIC_ prefix: only server code can read it. In the browser it is undefined.
RSC_DEMO_SERVER=only-the-server-reads-this

# NEXT_PUBLIC_ prefix: inlined into the browser's JavaScript at build. Never put a secret here.
NEXT_PUBLIC_RSC_DEMO=the-browser-reads-this-too
